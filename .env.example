# Public Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential
SUPABASE_SERVICE_ROLE_KEY=

# Server-only model provider credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Required for any non-default provider endpoint, comma-separated HTTPS origins
PROVIDER_ALLOWED_ORIGINS=

# Trusted outbound MCP origins and per-server credentials
MCP_ALLOWED_ORIGINS=
# MCP_TOKEN_<SERVER_UUID_WITH_UNDERSCORES>=

# Paddle: client token is public; all other secrets remain server-only
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_SIGNING_SECRET=
PADDLE_PRICE_SOLO_MONTHLY=
PADDLE_PRICE_SOLO_ANNUAL=
PADDLE_PRICE_TEAM_MONTHLY=
PADDLE_PRICE_TEAM_ANNUAL=

# Operational monitoring (server-only)
NEXORA_ENVIRONMENT=production
SLACK_WEBHOOK_URL=

# Optional operational email alerts: id of a verified mailbox; never public/VITE_
NEXORA_ALERT_MAILBOX_ID=
